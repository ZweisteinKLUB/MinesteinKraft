{
    // Tasks calling the launch script that matches the OS (run.sh on Linux / macOS, run.bat on Windows).
    "version": "2.0.0",
    "tasks": [
        {
            "label": "MinesteinKraft: préparer l'environnement",
            "detail": "Crée .venv et installe les dépendances si besoin (run.sh / run.bat --setup-only)",
            "type": "shell",
            "command": "./run.sh",
            "args": ["--setup-only"],
            "windows": { "command": ".\\run.bat" },
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": { "reveal": "silent", "panel": "shared", "clear": true },
            "problemMatcher": []
        },
        {
            "label": "MinesteinKraft: lancer (script)",
            "detail": "Lance le jeu avec run.sh / run.bat, sans débogueur",
            "type": "shell",
            "command": "./run.sh",
            "windows": { "command": ".\\run.bat" },
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": { "reveal": "always", "panel": "dedicated" },
            "problemMatcher": []
        },
        {
            "label": "MinesteinKraft: tests",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "windows": { "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe" },
            "args": ["-m", "pytest", "-q"],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "MinesteinKraft: préparer l'environnement",
            "group": "test",
            "problemMatcher": []
        }
    ]
}
